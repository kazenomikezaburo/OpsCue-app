# 名前と安全な既定値のみ。各自の値は.env.localへ保存しCommitしない。
# NODE_ENVは実行方式に任せ、このテンプレートでは上書きしない。

# === 必須：ローカルSupabase／ブラウザ公開対象 ===
# 各自がローカル環境から取得。空値では認証・DB連携は利用できない。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# === 任意：通知のログイン継続／サーバー専用 ===
# 検証時のみ各自でランダムな32文字以上の値をローカル生成。
# 未設定では署名付き継続導線を検証できない。
OPSCUE_CONTINUATION_SECRET=

# === 任意：LINE連携／通常開発では空のまま ===
# 未設定ではLINE設定条件を満たさない。全体のMockではない。
# 秘密はサーバー専用。ID・originも公開変数にはしない。
OPSCUE_APP_ORIGIN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_SECRET=
OPSCUE_LINE_INTERNAL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# Dispatcher・Schedulerを起動しない。この値だけで全LINE通信は遮断されない。
LINE_DELIVERY_ENABLED=false

# === 別承認のローカル統合テスト専用／サーバー専用 ===
# 未設定では対応テスト・Auth fixture準備は利用できない。
# service-roleはローカル準備限定。実値を共有しない。
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# TZ=Asia/Tokyo

# === Dispatcherの合成テスト専用 ===
# 通常のWeb開発では使用しない。既存MockはNODE_ENV=test等の条件に限定。
# LINE_PROVIDER_MOCK_MODE=true
# LINE_PROVIDER_MOCK_ENDPOINT=
